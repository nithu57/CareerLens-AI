# ==============================================================================
# CareerLens AI - Client-Side Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env.local and populate with your Firebase Web App credentials
# from the Firebase Console:
# https://console.firebase.google.com/project/careerlens-ai-8beae/settings/general
# Scroll down to "Your apps" -> Select "CareerLens AI Website" (Web app)
#
# NOTE: VITE_ prefixed variables are embedded in the client bundle.
# NEVER store backend secrets (Gemini API key, Adzuna credentials, YouTube key) here!
# Backend secrets are configured securely in Firebase Cloud Functions via Secret Manager.
# ==============================================================================

# Firebase Web App Configuration (Project ID: careerlens-ai-8beae)
# Replace YOUR_ACTUAL_API_KEY with the 39-character key starting with "AIzaSy..."
VITE_FIREBASE_API_KEY=YOUR_ACTUAL_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=careerlens-ai-8beae.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=careerlens-ai-8beae
VITE_FIREBASE_STORAGE_BUCKET=careerlens-ai-8beae.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_ACTUAL_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_ACTUAL_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: Firebase Functions region (defaults to us-central1)
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# Optional: Cloud Functions Backend URL (leave blank to use verified benchmarks)
VITE_BACKEND_API_URL=
